# SmartScout Environment Configuration Template
# Copy to .env when running with Docker Compose or export variables locally.

# PostgreSQL settings (Docker Compose)
POSTGRES_DB=SmartScoutDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_HOST_PORT=5433

# Host port exposed by SmartScout Web + API container
SMARTSCOUT_PORT=6050

# Admin key required for POST /api/players/sync, sync-stats, sync-injuries, enrich-bios
SMARTSCOUT_API_KEY=change-me-strong-sync-api-key

# Set to true to apply EF Core migrations automatically on API startup
SMARTSCOUT_AUTO_MIGRATE=true

# Optional: Set when running outside Docker against an external PostgreSQL instance
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=SmartScoutDb;Username=postgres;Password=change-me
