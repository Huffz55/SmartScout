{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "Hosting": {
    "EnableHttpsRedirection": false
  },
  "ScraperSettings": {
    "Headless": true,
    "DelayBetweenRequestsMs": 3500,
    "EnableBackgroundSync": true,
    "EnableLiveInjuryAutoSync": true,
    "InjurySyncIntervalHours": 4,
    "CurrentSeasonStatRefreshHours": 24,
    "LiveSeasonYear": 2027,
    "StartupSyncDelaySeconds": 20,
    "EuroSeasons": [ 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026, 2027 ],
    "EuroMaxConcurrentRequests": 2,
    "EuroDelayBetweenWavesMs": 1200
  },
  "Authentication": {
    "ApiKey": ""
  }
}
